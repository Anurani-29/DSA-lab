#include <stdio.h>
#include <stdlib.h>

void prins(int a[10][10],int n)
{
    int i,j,u,v,mincost=0,min,x,y,visited[10],ne=1;
    for(i=1;i<=n;i++)
        visited[i]=0;
    visited[1]=1;
    printf("\nThe edge considered are\n");
    while(ne<n)
    {
        for(i=1,min=999;i<=n;i++)
            for(j=1;j<=n;j++)
            if(a[i][j]<min)
        {
            if(visited[i]!=0)
            {
                min=a[i][j];
                x=u=i;
                y=v=j;
            }
        }
        if(visited[u]==0 || visited[v]==0)
        {
            printf("\nEdge %d,(%d,%d)=%d",ne++,x,y,min);
            mincost=mincost+min;
            visited[y]=1;
        }
        a[x][y]=a[y][x]=999;
    }
    printf("\nThe cost of mst is %d",mincost);
}
int main()
{
    int n,i,j,a[10][10];
    printf("\nRead number of vertices");
    scanf("%d",&n);
    printf("\nRead the cost matrix\n");
    for(i=1;i<=n;i++)
    {
        for(j=1;j<=n;j++)
        {
            scanf("%d",&a[i][j]);
            if(a[i][j]==0)
                a[i][j]=999;
        }
    }
    prins(a,n);

    return 0;
}
